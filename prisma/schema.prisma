// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// Moderation action types
enum ModAction {
  BAN
  UNBAN
  KICK
  TIMEOUT
  WARN
  SOFTBAN
  TEMPBAN
  MUTE_TEXT
  MUTE_VOICE
  MUTE_BOTH
  UNMUTE_TEXT
  UNMUTE_VOICE
  UNMUTE_BOTH
}

// Mute type variants
enum MuteType {
  TEXT // Can't send messages in text channels
  VOICE // Server deafened in voice channels
  BOTH // Both text and voice muted
}

// Permission system enums
enum PermissionSubjectType {
  USER
  ROLE
}

enum PermissionResourceType {
  COMMAND
  CATEGORY
  RESOURCE
}

enum PermissionEffect {
  ALLOW
  DENY
}

// Evidence system enums
enum EvidenceType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  URL
  DISCORD_URL
  MESSAGE_SNAPSHOT
}

enum EvidenceStatus {
  PENDING // Awaiting upload completion
  PROCESSING // NSFW scan / signing in progress
  VERIFIED // Passed all checks, immutable
  FLAGGED // Failed NSFW check, user confirmed safe
  REJECTED // Illegal/explicit content, not stored
}

// Moderation case status
enum CaseStatus {
  OPEN
  CLOSED
  VOID
}

// Appeal status
enum AppealStatus {
  PENDING
  APPROVED
  DENIED
}

// Example models for a Discord bot
// You can modify or remove these based on your needs

model Guild {
  id        String   @id @default(cuid())
  guildId   String   @unique
  name      String
  language  String   @default("en-US")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  settings  Json?

  users             User[]
  modCases          ModCase[]
  modConfig         ModConfig?
  logConfig         LogConfig?
  vanityConfig      VanityConfig?
  xpConfig          GuildXPConfig?
  userXP            UserXP[]
  xpEventLogs       XPEventLog[]
  voiceXPConfig     GuildVoiceXPConfig?
  userVoiceXP       UserVoiceXP[]
  voiceXPEventLogs  VoiceXPEventLog[]
  voiceSessions     VoiceSession[]
  reputationVouches ReputationVouch[]
  evidence          Evidence[]
  messageSnapshots  MessageSnapshot[]

  @@index([guildId])
  @@map("guilds")
}

// Presence-driven vanity role configuration per guild. Discord role assignments are the
// observed state; this table stores only the desired guild-level policy.
model VanityConfig {
  id      String @id @default(cuid())
  guildId String @unique

  enabled Boolean @default(false)
  keyword String  @default("")
  roleId  String?

  thankYouEnabled   Boolean @default(false)
  thankYouChannelId String?
  thankYouMessage   String  @default("Thanks {user} for supporting the server! You received {role}.")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@map("vanity_configs")
}

model User {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild   Guild?  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId String?

  @@index([userId])
  @@index([guildId])
  @@map("users")
}

model Log {
  id        String   @id @default(cuid())
  level     String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
  @@map("logs")
}

// Moderation Case Tracking
model ModCase {
  id            String     @id @default(cuid())
  caseNumber    Int // Auto-incrementing per guild
  guildId       String
  action        ModAction
  targetId      String
  targetTag     String
  moderatorId   String
  moderatorTag  String
  reason        String?
  duration      Int? // Duration in seconds for timeouts/tempbans
  status        CaseStatus @default(OPEN)
  evidence      Json? // Message links, attachments, etc.
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  expiresAt     DateTime?
  // NH-10: Case Assignment
  assignedToId  String?
  assignedToTag String?
  assignedAt    DateTime?

  guild         Guild      @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  evidenceItems Evidence[]
  notes         CaseNote[]

  @@unique([guildId, caseNumber])
  @@index([guildId])
  @@index([targetId])
  @@index([moderatorId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("mod_cases")
}

// Moderation Configuration per Guild
model ModConfig {
  id                 String   @id @default(cuid())
  guildId            String   @unique
  modLogChannelId    String? // Channel for moderation logs
  muteRoleId         String? // Role for muting users (legacy, use mutedTextRole)
  mutedTextRole      String? // Role to apply for text mutes
  mutedVoiceRole     String? // Role to apply for voice mutes (alternative to server mute)
  muteSettings       Json     @default("{}") // { allowInThreads: false, exemptChannels: [] }
  autoModEnabled     Boolean  @default(false)
  warningEscalation  Json     @default("{}") // { enabled: true, thresholds: { 3: 'timeout', 5: 'mute', 10: 'tempban' } }
  metadata           Json? // Guild-level config like { customEvidenceTags: string[] }
  // NH-8: Watermark Config
  watermarkDownloads Boolean  @default(true)
  watermarkText      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("mod_configs")
}

// Case Discussion Notes
model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  guildId   String
  authorId  String
  authorTag String
  content   String   @db.Text
  createdAt DateTime @default(now())

  case ModCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([guildId])
  @@index([createdAt])
  @@map("case_notes")
}

// Active Mutes tracking
model Mute {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  createdById String
  type        MuteType
  reason      String
  duration    Int? // seconds, null = permanent
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  active      Boolean   @default(true)

  @@unique([guildId, userId, type])
  @@index([guildId, active])
  @@index([expiresAt])
  @@map("mutes")
}

// User Flags for moderation tracking
model UserFlag {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  flag        String // SUSPICIOUS, AUTO_FLAGGED, RAID_PARTICIPANT, ALT_ACCOUNT, TRUSTED, APPEALED
  reason      String?
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)

  @@unique([guildId, userId, flag])
  @@index([guildId, active])
  @@map("user_flags")
}

// Case Templates for quick moderation actions
model CaseTemplate {
  id          String    @id @default(cuid())
  guildId     String
  name        String
  action      ModAction
  reason      String
  duration    String? // Duration string like "1h", "7d"
  createdById String
  createdAt   DateTime  @default(now())

  @@unique([guildId, name])
  @@index([guildId])
  @@map("case_templates")
}

// Moderation Queue for pending review items
model ModerationQueueItem {
  id           String    @id @default(cuid())
  guildId      String
  targetId     String
  reportedById String?
  reason       String
  priority     Int       @default(0)
  status       String    @default("pending") // pending, claimed, resolved
  claimedById  String?
  claimedAt    DateTime?
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@index([guildId, status])
  @@index([priority])
  @@map("moderation_queue")
}

// Moderation Events for analytics
model ModEvent {
  id        String   @id @default(cuid())
  guildId   String
  timestamp DateTime @default(now())

  // Actor
  actorId   String
  actorType String // user, bot, automod

  // Target
  targetId   String?
  targetType String? // user, message, channel, role

  // Action
  action   String // ModAction enum or custom action string
  category String // punishment, info, config, appeal

  // Context
  reason   String?
  metadata Json    @default("{}")

  // Outcome
  success   Boolean
  errorType String?
  latencyMs Int     @default(0)

  // Correlation
  caseId        String?
  caseNumber    Int?
  correlationId String? // Link related events

  @@index([guildId, timestamp])
  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@map("mod_events")
}

// Logging Configuration per Guild
model LogConfig {
  id         String  @id @default(cuid())
  guildId    String  @unique
  categoryId String? // Category for log channels
  enabled    Boolean @default(false)

  // Enable/disable specific log types
  messagesEnabled    Boolean @default(false)
  voiceEnabled       Boolean @default(false)
  voiceStateEnabled  Boolean @default(false)
  ticketsEnabled     Boolean @default(false)
  transcriptsEnabled Boolean @default(false)
  rolesEnabled       Boolean @default(false)
  channelsEnabled    Boolean @default(false)
  membersEnabled     Boolean @default(false)
  stageEnabled       Boolean @default(false)
  eventsEnabled      Boolean @default(false)
  pollsEnabled       Boolean @default(false)
  emojisEnabled      Boolean @default(false)
  stickersEnabled    Boolean @default(false)
  webhooksEnabled    Boolean @default(false)
  joinsEnabled       Boolean @default(false)
  leavesEnabled      Boolean @default(false)
  serverEnabled      Boolean @default(false)

  // Ignored channels - logs from these channels won't be recorded
  ignoredChannels String[] @default([])

  // Webhook URLs for each log type
  messagesWebhook    String?
  voiceWebhook       String?
  voiceStateWebhook  String?
  ticketsWebhook     String?
  transcriptsWebhook String?
  rolesWebhook       String?
  channelsWebhook    String?
  membersWebhook     String?
  stageWebhook       String?
  eventsWebhook      String?
  pollsWebhook       String?
  emojisWebhook      String?
  stickersWebhook    String?
  webhooksWebhook    String?
  joinsWebhook       String?
  leavesWebhook      String?
  serverWebhook      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("log_configs")
}

// User Moderation Notes
model UserModNote {
  id          String   @id @default(cuid())
  guildId     String
  userId      String // Target user ID
  createdById String // Moderator who created the note
  note        String   @db.Text
  tags        String[] // Tags for categorization
  createdAt   DateTime @default(now())

  @@index([guildId])
  @@index([userId])
  @@index([guildId, userId])
  @@index([createdById])
  @@map("user_mod_notes")
}

// Moderation Appeals
model ModAppeal {
  id           String       @id @default(cuid())
  guildId      String
  targetId     String // User who submitted the appeal
  caseId       String? // Optional reference to the case being appealed
  createdById  String // Can be different from targetId if mod creates on behalf
  reason       String       @db.Text
  status       AppealStatus @default(PENDING)
  resolution   String?      @db.Text
  resolvedById String? // Moderator who resolved the appeal
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  resolvedAt   DateTime?

  @@index([guildId])
  @@index([targetId])
  @@index([status])
  @@index([guildId, status])
  @@map("mod_appeals")
}

// ============================================
// Evidence Management System
// ============================================

// Evidence attached to moderation cases
model Evidence {
  id            String         @id @default(cuid())
  guildId       String
  caseId        String
  caseNumber    Int // Denormalized for fast lookups
  uploadedById  String // Discord user ID
  uploadedByTag String
  type          EvidenceType
  status        EvidenceStatus @default(PENDING)

  // Storage
  storageKey       String? // B2 object key (null for URLs)
  storageBucket    String?
  originalFilename String?
  mimeType         String?
  sizeBytes        Int?

  // Integrity
  contentHash   String? // SHA-256 of file content
  hmacSignature String? // HMAC-SHA256 with server secret

  // URL evidence
  url String? // For URL/DISCORD_URL types

  // Snapshot reference
  snapshotId String? // FK to MessageSnapshot.id

  // Metadata
  description String?
  metadata    Json?
  tags        String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guild      Guild               @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  case       ModCase             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  snapshot   MessageSnapshot?    @relation(fields: [snapshotId], references: [id])
  amendments EvidenceAmendment[]
  accessLogs EvidenceAccessLog[]

  @@index([guildId])
  @@index([caseId])
  @@index([caseNumber, guildId])
  @@index([uploadedById])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([tags])
  @@index([guildId, createdAt(sort: Desc), id], map: "evidence_guild_created_id_idx")
  @@index([guildId, caseNumber, createdAt(sort: Desc), id], map: "evidence_guild_case_created_id_idx")
  @@index([guildId, type, createdAt(sort: Desc), id], map: "evidence_guild_type_created_id_idx")
  @@index([guildId, status, createdAt(sort: Desc), id], map: "evidence_guild_status_created_id_idx")
  @@map("evidence")
}

// Append-only history log for evidence amendments
model EvidenceAmendment {
  id            String   @id @default(cuid())
  evidenceId    String
  amendedById   String // Discord user ID
  amendedByTag  String
  action        String // "NOTE_ADDED", "DESCRIPTION_UPDATED", "FLAGGED", "UNFLAGGED"
  previousValue String? // JSON of what changed
  newValue      String? // JSON of new value
  reason        String?
  createdAt     DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([amendedById])
  @@index([createdAt])
  @@map("evidence_amendments")
}

// NH-9: Evidence access logging for chain of custody
model EvidenceAccessLog {
  id         String   @id @default(cuid())
  evidenceId String
  guildId    String
  userId     String
  userTag    String
  action     String // "VIEW", "DOWNLOAD", "EXPORT"
  ipHash     String? // SHA-256 of IP for audit without PII storage
  userAgent  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([guildId])
  @@index([createdAt])
  @@map("evidence_access_logs")
}

// Captured message state for evidence preservation
model MessageSnapshot {
  id            String @id @default(cuid())
  guildId       String
  channelId     String
  capturedById  String // Moderator who triggered the capture
  capturedByTag String

  // Range info
  firstMessageId String
  lastMessageId  String? // Null if single message
  messageCount   Int     @default(1)

  // Serialized content (the actual snapshot data)
  snapshotData Json // Array of MessageSnapshotEntry objects

  // Storage for media extracted from messages
  mediaStorageKeys Json? // Array of B2 keys for attachments/embeds captured

  // Integrity
  contentHash   String // SHA-256 of snapshotData JSON
  hmacSignature String // HMAC-SHA256 with server secret

  createdAt DateTime @default(now())

  guild    Guild      @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  evidence Evidence[]

  @@index([guildId])
  @@index([channelId])
  @@index([capturedById])
  @@index([firstMessageId])
  @@map("message_snapshots")
}

// Scheduled Tasks for Tempbans
model ScheduledTask {
  id        String   @id @default(cuid())
  type      String // e.g., "TEMPBAN_UNBAN"
  guildId   String
  targetId  String
  data      Json? // Additional task data
  executeAt DateTime
  createdAt DateTime @default(now())
  processed Boolean  @default(false)

  @@index([type])
  @@index([executeAt])
  @@index([processed, executeAt])
  @@map("scheduled_tasks")
}

// Permission Grants for custom permission system
model PermissionGrant {
  id           String                 @id @default(cuid())
  guildId      String
  subjectType  PermissionSubjectType
  subjectId    String // Discord user or role ID
  resourceType PermissionResourceType
  resourceKey  String // Command key (e.g., "mod.warn") or category key (e.g., "moderation")
  effect       PermissionEffect
  createdById  String? // Moderator who created this grant
  createdAt    DateTime               @default(now())

  @@unique([guildId, subjectType, subjectId, resourceType, resourceKey])
  @@index([guildId])
  @@index([guildId, subjectType, subjectId])
  @@index([guildId, resourceType, resourceKey])
  @@map("permission_grants")
}

// XP/Leveling Configuration per Guild
model GuildXPConfig {
  id      String  @id @default(cuid())
  guildId String  @unique
  enabled Boolean @default(true)

  // XP Award Settings
  cooldownSec      Int    @default(60) // Cooldown between XP awards
  xpMode           String @default("RANDOM") // "RANDOM" | "FIXED"
  minXp            Int    @default(15) // For RANDOM mode
  maxXp            Int    @default(25) // For RANDOM mode
  fixedXp          Int    @default(20) // For FIXED mode
  minMessageLength Int    @default(5) // Minimum message length to award XP
  maxXpPerMinute   Int? // Optional rate limit

  // Channel & Role Filters (JSONB arrays)
  allowedChannels String[] @default([]) // If empty, all channels allowed
  ignoredChannels String[] @default([]) // Always ignored
  ignoredRoles    String[] @default([]) // Users with these roles ignored

  // Level-Up Announcements
  announceLevelUp   Boolean @default(true)
  announceChannelId String? // If null, announce in message channel
  messageTemplate   String  @default("🎉 {user} reached level {level}!")
  embedEnabled      Boolean @default(true)
  embedColor        Int     @default(5793266) // Hex 0x5865F2 (Discord Blurple)

  // Level Curve Configuration
  levelCurveType  String @default("FORMULA") // "FORMULA" | "TABLE"
  // Formula: xpRequired = base * (level ^ exponent) + offset
  formulaBase     Float  @default(5.0)
  formulaExponent Float  @default(2.0)
  formulaOffset   Float  @default(50.0)
  // Table: Array of cumulative XP thresholds [100, 255, 475, 770, ...] for levels 1, 2, 3, 4...
  tableThresholds Int[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_xp_configs")
}

// User XP per Guild
model UserXP {
  id           String    @id @default(cuid())
  guildId      String
  userId       String
  xp           Int       @default(0)
  level        Int       @default(0)
  messageCount Int       @default(0)
  lastAwardAt  DateTime? // For cooldown enforcement
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, xp(sort: Desc)]) // For leaderboard queries
  @@index([guildId, userId])
  @@index([lastAwardAt]) // For cooldown checks
  @@map("user_xp")
}

// Audit Log for XP Events (optional but recommended)
model XPEventLog {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  eventType   String // "AWARD" | "LEVEL_UP" | "RESET" | "MANUAL_ADJUST"
  xpChange    Int // Amount of XP change (can be negative)
  xpBefore    Int
  xpAfter     Int
  levelBefore Int
  levelAfter  Int
  reason      String? // Optional context (e.g., "message", "admin reset")
  metadata    Json? // Additional context (channelId, messageId, etc.)
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@index([eventType])
  @@map("xp_event_logs")
}

// ============================================
// Voice XP System Models
// ============================================

// Voice XP Configuration per Guild
model GuildVoiceXPConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // XP Award Settings
  xpPerMinute       Int    @default(5) // XP awarded per minute in voice
  minSessionMinutes Int    @default(1) // Minimum minutes before XP is awarded
  xpMode            String @default("PER_MINUTE") // "PER_MINUTE" | "PER_SESSION"

  // Channel Filters
  allowedChannels String[] @default([]) // If not empty, only these channels award XP
  ignoredChannels String[] @default([]) // These channels never award XP

  // User State Filters
  awardMuted       Boolean @default(false) // Award XP to muted users?
  awardDeafened    Boolean @default(false) // Award XP to deafened users?
  awardStreaming   Boolean @default(true) // Award XP to streaming users?
  awardVideo       Boolean @default(true) // Award XP to video users?
  ignoreAfkChannel Boolean @default(true) // Ignore AFK channel?

  // Optional anti-farm dampening (reduces XP, doesn't hard-block)
  antiFarmDampeningEnabled    Boolean @default(false)
  antiFarmDampeningMultiplier Float   @default(0.35)
  antiFarmMinimumParticipants Int     @default(2)

  // Role Filters
  ignoredRoles String[] @default([]) // Users with these roles don't earn XP

  // Level-Up Announcements
  announceLevelUp   Boolean @default(true)
  announceChannelId String? // If null, announce in text channel
  messageTemplate   String  @default("🎤 {user} reached voice level {level}!")
  embedEnabled      Boolean @default(true)
  embedColor        Int     @default(5814783) // Discord embed color (hex: 58B9FF)

  // Level Curve Configuration
  levelCurveType  String @default("FORMULA") // "FORMULA" | "TABLE"
  formulaBase     Float  @default(5.0) // Base XP required
  formulaExponent Float  @default(2.0) // Level scaling exponent
  formulaOffset   Float  @default(50.0) // Additional XP offset
  tableThresholds Int[]  @default([]) // Custom XP thresholds per level

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId])
  @@map("guild_voice_xp_configs")
}

// User Voice XP per Guild
model UserVoiceXP {
  id             String    @id @default(cuid())
  guildId        String
  userId         String
  xp             Int       @default(0)
  level          Int       @default(0)
  minutesInVoice Int       @default(0) // Total minutes tracked
  lastAwardAt    DateTime? // Last XP award time
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, xp(sort: Desc)]) // For leaderboard queries
  @@index([guildId, userId])
  @@map("user_voice_xp")
}

// Voice Session Tracking
model VoiceSession {
  id              String    @id @default(cuid())
  guildId         String
  userId          String
  channelId       String
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?
  durationMinutes Int       @default(0) // Calculated on session end
  xpAwarded       Int       @default(0) // XP awarded for this session
  wasMuted        Boolean   @default(false)
  wasDeafened     Boolean   @default(false)
  wasStreaming    Boolean   @default(false)
  wasVideo        Boolean   @default(false)

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, userId, leftAt]) // For active session queries
  @@index([joinedAt])
  @@map("voice_sessions")
}

// Audit Log for Voice XP Events
model VoiceXPEventLog {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  eventType   String // "AWARD" | "LEVEL_UP" | "RESET" | "SESSION_END"
  xpChange    Int
  xpBefore    Int
  xpAfter     Int
  levelBefore Int
  levelAfter  Int
  reason      String?
  metadata    Json? // Session details, channel info
  createdAt   DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, createdAt])
  @@index([eventType])
  @@map("voice_xp_event_logs")
}

// ============================================
// Temporary Voice Channels Module
// ============================================

// Naming scheme for temporary voice channels
enum TempVoiceNamingScheme {
  USERNAME // Use Discord username
  DISPLAYNAME // Use Discord display name/nickname
  SEQUENTIAL // Numbered channels (e.g., "Channel 1", "Channel 2")
  CUSTOM // Use custom template from defaultNameTemplate
}

enum TempVoiceLifecycle {
  CREATING
  ACTIVE
  DELETE_PENDING
  DELETING
  DELETE_FAILED
  DELETED
}

enum TempVoiceOwnershipStatus {
  OWNER_PRESENT
  OWNER_GRACE
  CLAIMABLE
}

enum TempVoiceEffectKind {
  CREATE_CHANNEL
  MOVE_OWNER
  DISCONNECT_USERS
  DELETE_CHANNEL
  RECONCILE_CHANNEL
  RECONCILE_PERMISSIONS
  RECONCILE_PANEL
  DELIVER_OWNERSHIP_NOTICE
  DELIVER_OWNER_DM
}

enum TempVoiceOutboxStatus {
  PENDING
  ENQUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum TempVoiceDeliveryKind {
  CONTROL_PANEL
  OWNERSHIP_NOTICE
  OWNER_DM
}

enum TempVoiceDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SUPERSEDED
}

// Configuration for the temp voice module per guild
model TempVoiceConfig {
  id         String    @id @default(cuid())
  guildId    String    @unique
  enabled    Boolean   @default(true)
  drainingAt DateTime?

  // Join to Create channels
  joinToCreateChannels Json @default("[]") // string[] of channel IDs

  // Creation settings
  categoryId          String?
  fallbackCategoryId  String?
  namingScheme        TempVoiceNamingScheme @default(USERNAME)
  defaultNameTemplate String                @default("{username}'s Channel")

  // Default channel settings
  defaultUserLimit Int     @default(0) // 0 = unlimited
  defaultBitrate   Int?    @default(64) // null = Discord default (in kbps)
  defaultRegion    String? // null = auto
  defaultLocked    Boolean @default(false)
  defaultHidden    Boolean @default(false)

  // Cleanup settings
  deleteDelaySeconds Int @default(300)

  // Anti-abuse
  cooldownSeconds    Int @default(10)
  maxChannelsPerUser Int @default(3)

  // Control panel
  controlPanelEnabled Boolean @default(true)
  allowCustomization  Boolean @default(true) // Allow users to customize their channels

  // Logging
  logChannelId String?
  logWebhook   String? // Webhook URL for logging

  // Permissions
  adminRoleIds Json @default("[]") // string[] - roles that can manage any temp channel

  // Name Moderation settings (optional, disabled by default)
  moderationEnabled Boolean                   @default(false) // Disabled by default - admins must opt-in
  moderationAction  TempVoiceModerationAction @default(AUTO_RENAME)
  strictMode        Boolean                   @default(false) // Enable aggressive heuristics
  allowListEnabled  Boolean                   @default(false) // Whitelist mode
  customPatterns    Json                      @default("[]") // string[] - Guild-specific regex patterns
  allowedKeywords   Json                      @default("[]") // string[] - Guild allowlist

  // Multi-language settings (Phase 7)
  primaryLanguage     String  @default("en") // Primary language (ISO 639-1)
  additionalLanguages Json    @default("[]") // string[] - Additional languages to check
  multiLangMode       Boolean @default(false) // Check all languages vs primary only
  languageSettings    Json    @default("{}") // Language-specific settings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("temp_voice_configs")
}

// Active temporary voice channels
model TempVoiceChannel {
  id          String  @id @default(cuid())
  guildId     String
  channelId   String? @unique
  ownerId     String
  operationId String  @unique

  lifecycle       TempVoiceLifecycle       @default(CREATING)
  ownershipStatus TempVoiceOwnershipStatus @default(OWNER_PRESENT)
  revision        Int                      @default(0)
  ownershipEpoch  Int                      @default(0)
  ownerAbsentAt   DateTime?
  claimableAt     DateTime?

  // Creation context
  createdByJoinChannelId String
  createdAt              DateTime @default(now())
  lastActiveAt           DateTime @default(now())

  // Custom settings (null = using defaults)
  customName      String?
  customUserLimit Int?
  customBitrate   Int?
  customRegion    String?

  // State flags
  isLocked Boolean @default(false)
  isHidden Boolean @default(false)

  // Permission overrides
  allowedUserIds Json @default("[]") // string[]
  deniedUserIds  Json @default("[]") // string[]
  trustedUserIds Json @default("[]") // string[] - users with owner-like permissions (except claim)
  managedUserIds Json @default("[]") // string[] - member overwrites owned by this module

  // Deletion management
  emptySince       DateTime?
  deleteAfter      DateTime?
  nextReconcileAt  DateTime  @default(now())
  lastReconciledAt DateTime?
  failureCount     Int       @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  deletedAt        DateTime?

  // Control panel
  controlPanelMessageId String?
  controlPanelChannelId String?

  // Metadata
  metadata Json @default("{}")

  outbox     TempVoiceOutbox[]
  deliveries TempVoiceDelivery[]

  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@index([ownerId])
  @@index([channelId])
  @@index([lifecycle, nextReconcileAt])
  @@index([ownershipStatus, claimableAt])
  @@index([deleteAfter])
  @@map("temp_voice_channels")
}

model TempVoiceOutbox {
  id          String                @id @default(cuid())
  aggregateId String
  aggregate   TempVoiceChannel      @relation(fields: [aggregateId], references: [id], onDelete: Cascade)
  revision    Int
  kind        TempVoiceEffectKind
  payload     Json                  @default("{}")
  dedupeKey   String                @unique
  status      TempVoiceOutboxStatus @default(PENDING)
  attempts    Int                   @default(0)
  availableAt DateTime              @default(now())
  lastError   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?

  @@index([status, availableAt])
  @@index([status, completedAt])
  @@index([aggregateId, revision])
  @@map("temp_voice_outbox")
}

model TempVoiceDelivery {
  id            String                  @id @default(cuid())
  aggregateId   String
  aggregate     TempVoiceChannel        @relation(fields: [aggregateId], references: [id], onDelete: Cascade)
  kind          TempVoiceDeliveryKind
  epoch         Int                     @default(0)
  destinationId String?
  messageId     String?
  renderHash    String?
  status        TempVoiceDeliveryStatus @default(PENDING)
  attempts      Int                     @default(0)
  lastError     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([aggregateId, kind, epoch])
  @@index([status, updatedAt])
  @@map("temp_voice_deliveries")
}

// User-specific temp voice channel preferences
model TempVoiceUserPreference {
  id      String @id @default(cuid())
  guildId String
  userId  String

  // Saved channel settings
  customName      String?
  customUserLimit Int?
  customBitrate   Int?
  customRegion    String?

  // Saved state flags
  preferLocked Boolean @default(false)
  preferHidden Boolean @default(false)

  // Saved permission lists
  allowedUserIds Json @default("[]") // string[]
  deniedUserIds  Json @default("[]") // string[]
  trustedUserIds Json @default("[]") // string[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@map("temp_voice_user_preferences")
}

// ============================================================================
// TEMP VOICE NAME MODERATION
// ============================================================================

// Moderation action enforcement strategies
enum TempVoiceModerationAction {
  AUTO_RENAME // Automatically rename to safe name
  BLOCK // Revert to previous name
  WARN_ONLY // Log and notify but allow
}

// Keyword approval status
enum KeywordApprovalStatus {
  PENDING // Awaiting manual review
  APPROVED // Added to blocklist
  DENIED // Not added to blocklist
  IGNORED // Dismissed without action
}

// Moderation log entries
model TempVoiceModerationLog {
  id        String @id @default(cuid())
  guildId   String
  channelId String
  userId    String

  // Event details
  originalName   String
  normalizedName String
  finalName      String? // Name after moderation action

  // Detection details
  isAllowed       Boolean
  reasonCodes     Json    @default("[]") // string[] of reason codes
  matchedPatterns Json    @default("[]") // PatternMatch[] objects
  heuristicScore  Float? // Optional heuristic score

  // Language detection (Phase 7)
  detectedLanguage String? // Detected language (ISO 639-1)
  matchedLanguage  String? // Language that matched pattern

  // Action taken
  actionTaken  String // AUTO_RENAMED, BLOCKED, WARNED, ALLOWED
  strategyUsed String? // For auto-rename: SAFE_TEMPLATE, CREATIVE_COMBO, etc.

  // Metadata
  processingTimeMs Int?
  metadata         Json @default("{}")

  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@index([channelId])
  @@index([userId])
  @@index([createdAt])
  @@index([detectedLanguage])
  @@map("temp_voice_moderation_logs")
}

// Pending keywords from Discovery revocations or manual reports
model TempVoiceKeywordQueue {
  id      String @id @default(cuid())
  guildId String

  // Keyword details
  keyword           String
  normalizedKeyword String
  source            String // DISCOVERY_REVOCATION, MANUAL_REPORT, AUTO_DETECTED
  contextSnippet    String? // Original full name that triggered it

  // Context
  channelId String?
  userId    String?

  // Review status
  status     KeywordApprovalStatus @default(PENDING)
  reviewedBy String? // User ID of reviewer
  reviewedAt DateTime?
  reviewNote String?

  // Metadata
  occurrences Int      @default(1) // How many times detected
  lastSeenAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, normalizedKeyword])
  @@index([guildId, status])
  @@index([status, createdAt])
  @@map("temp_voice_keyword_queue")
}

// Global moderation patterns (admin-managed)
model TempVoiceModerationPattern {
  id String @id @default(cuid())

  // Pattern details
  pattern     String // Regex pattern
  patternType String // PROFANITY, HATE_SPEECH, SPAM, OBFUSCATION, etc.
  description String?
  severity    Int     @default(5) // 1-10 scale

  // Language support (Phase 7)
  language        String  @default("en") // ISO 639-1 language code
  regionalVariant String? // Regional variant (e.g., 'US', 'GB', 'MX')

  // Configuration
  enabled         Boolean @default(true)
  caseInsensitive Boolean @default(true)

  // Usage tracking
  matchCount    Int       @default(0)
  lastMatchedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, patternType])
  @@index([enabled, language, patternType])
  @@map("temp_voice_moderation_patterns")
}

// ============================================================================
// REPUTATION SYSTEM
// ============================================================================

// User reputation/social credit tracking
model UserReputation {
  id      String @id @default(cuid())
  guildId String
  userId  String

  // Reputation scores
  reputationScore Int @default(0) // Total reputation points
  vouchesReceived Int @default(0) // Count of vouches received
  vouchesGiven    Int @default(0) // Count of vouches given

  // Reputation breakdown by type
  helpfulVouches  Int @default(0)
  friendlyVouches Int @default(0)
  skilledVouches  Int @default(0)
  reliableVouches Int @default(0)

  // Tier system
  reputationTier String    @default("Bronze") // Bronze, Silver, Gold, Platinum, Diamond
  tierReachedAt  DateTime?

  // Anti-abuse tracking
  lastVouchGiven     DateTime?
  suspiciousActivity Boolean   @default(false)

  // Decay system
  lastActiveDate DateTime  @default(now())
  decayAppliedAt DateTime?

  // Stats & achievements
  longestVouchStreak Int @default(0)
  totalHelpfulness   Int @default(0) // Calculated metric

  // Metadata
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vouchesReceived_ ReputationVouch[] @relation("VouchReceiver")
  vouchesGiven_    ReputationVouch[] @relation("VouchGiver")

  @@unique([guildId, userId])
  @@index([guildId])
  @@index([userId])
  @@index([reputationScore])
  @@index([reputationTier])
  @@map("user_reputation")
}

// Individual vouch records
model ReputationVouch {
  id      String @id @default(cuid())
  guildId String

  // Who vouched for whom
  giverUserId    String
  receiverUserId String

  // Vouch details
  vouchType String // helpful, friendly, skilled, reliable
  reason    String? // Optional message
  weight    Int     @default(1) // Vouch weight (can vary by giver's reputation)

  // Context
  contextType String? // Where it happened: voice, text, event
  contextId   String? // Channel/event ID

  // Validation
  isValid     Boolean @default(true) // Can be invalidated if abuse detected
  validatedBy String? // Moderator who validated/invalidated

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  giver    UserReputation @relation("VouchGiver", fields: [guildId, giverUserId], references: [guildId, userId], onDelete: Cascade)
  receiver UserReputation @relation("VouchReceiver", fields: [guildId, receiverUserId], references: [guildId, userId], onDelete: Cascade)
  guild    Guild          @relation(fields: [guildId], references: [guildId], onDelete: Cascade)

  @@unique([guildId, giverUserId, receiverUserId, vouchType, createdAt])
  @@index([guildId])
  @@index([giverUserId])
  @@index([receiverUserId])
  @@index([vouchType])
  @@index([createdAt])
  @@map("reputation_vouches")
}

// ============================================
// XP Rewards System
// ============================================

// Configurable rewards per guild per level
model LevelReward {
  id         String @id @default(cuid())
  guildId    String
  level      Int // Level requirement
  xpType     String // "TEXT" | "VOICE" | "BOTH"
  rewardType String // See reward types below

  // Reward-specific data stored as JSON
  // Examples:
  // ROLE: { "roleId": "123456789", "action": "ADD" | "REMOVE" | "STACK" }
  // CURRENCY: { "amount": 1000, "currencyType": "coins" }
  // CHANNEL_ACCESS: { "channelIds": ["123", "456"], "action": "ADD" }
  // PERMISSION: { "permissions": ["EMBED_LINKS", "USE_EXTERNAL_EMOJIS"] }
  // MULTIPLIER: { "multiplier": 1.5, "durationMinutes": 1440 }
  // CUSTOM: { "customData": {...} }
  rewardData Json

  // Display settings
  name        String // e.g., "Gold Role", "VIP Access"
  description String? // User-friendly description
  icon        String? // Emoji or icon identifier

  // Behavior settings
  oneTime          Boolean @default(true) // Award once or repeatable
  stackable        Boolean @default(false) // Can accumulate (for roles/perms)
  requiresPrevious Boolean @default(false) // Must claim previous level rewards

  // Priority and ordering
  priority Int     @default(0) // Higher = applied first
  enabled  Boolean @default(true)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? // Admin who created this reward

  // Relations
  claimedRewards UserRewardClaim[]

  @@unique([guildId, level, xpType, rewardType, name])
  @@index([guildId])
  @@index([guildId, level, xpType])
  @@index([enabled])
  @@map("level_rewards")
}

// Track which rewards users have claimed
model UserRewardClaim {
  id       String @id @default(cuid())
  guildId  String
  userId   String
  rewardId String

  // Claim details
  levelAtClaim Int // Level when reward was claimed
  xpAtClaim    Int // XP total when claimed
  claimedAt    DateTime @default(now())

  // Status tracking
  status       String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED
  expiresAt    DateTime? // For temporary rewards
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?

  // Metadata
  metadata Json @default("{}") // Store additional context

  // Relations
  reward LevelReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId, rewardId])
  @@index([guildId, userId])
  @@index([rewardId])
  @@index([status])
  @@index([expiresAt])
  @@map("user_reward_claims")
}

// Reward presets/templates for easy setup
model RewardTemplate {
  id          String  @id @default(cuid())
  name        String // e.g., "Standard Role Progression"
  description String?
  category    String // "ROLES", "ECONOMY", "ACCESS", "MIXED"

  // Template data - array of reward configurations
  template Json // Full reward structure array

  // Visibility
  isPublic   Boolean @default(true) // Available to all guilds
  isOfficial Boolean @default(false) // Created by bot developer

  // Stats
  timesUsed Int    @default(0)
  rating    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
  @@map("reward_templates")
}
