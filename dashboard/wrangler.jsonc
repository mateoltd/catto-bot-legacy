{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catto-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "APP_ENV": "local",
    "BOT_API_INTERNAL_URL": "http://localhost:4000",
  },
  "env": {
    "development": {
      "routes": [
        {
          "pattern": "dev.catto.one",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "development",
        "BOT_API_INTERNAL_URL": "https://api-dev.catto.one",
      },
    },
    "production": {
      "routes": [
        {
          "pattern": "catto.one",
          "custom_domain": true,
        },
      ],
      "vars": {
        "APP_ENV": "production",
        "BOT_API_INTERNAL_URL": "https://api.catto.one",
      },
    },
  },
}
